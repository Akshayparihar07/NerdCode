{
  "name": "nerd-code",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "npm run test:unit && npm run test:d1",
    "test:unit": "vitest run --config vitest.config.mts",
    "test:d1": "vitest run --config vitest.d1.config.mts",
    "test:browser": "node scripts/test-pyodide-worker.mjs",
    "test:judge:release": "vitest run --config vitest.release.config.mts",
    "typecheck": "tsc --noEmit",
    "check": "biome check && tsc --noEmit && npm test",
    "verify": "npm run check && npm run test:browser && npm run build && npm run build:worker && wrangler deploy --dry-run --outdir .wrangler/deploy-dry-run"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "6.12.4",
    "@lezer/highlight": "1.2.3",
    "@opennextjs/cloudflare": "^1.20.6",
    "@phosphor-icons/react": "^2.1.10",
    "@uiw/react-codemirror": "^4.25.11",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "feral-blob": "^0.1.0",
    "motion": "12",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@cloudflare/vitest-plugin": "^1.1.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "playwright-core": "1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.1"
  }
}
